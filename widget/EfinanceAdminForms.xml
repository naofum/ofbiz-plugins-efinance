<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://ofbiz.apache.org/Widget-Form"
       xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <!-- Member list -->
    <form name="ListEfMembers" type="list" list-name="efMembers"
          target="ViewEfMember" paginate-target="FindEfMember">
        <field name="partyId" title="Party ID">
            <hyperlink description="${efMember.partyId}" target="ViewEfMember">
                <parameter param-name="partyId" from-field="partyId"/>
            </hyperlink>
        </field>
        <field name="userLoginId" title="Login / Email">
            <display/>
        </field>
        <field name="memberTypeEnumId" title="Type">
            <display/>
        </field>
        <field name="statusId" title="Status">
            <display/>
        </field>
        <field name="createdDate" title="Registered">
            <display type="date-time"/>
        </field>
        <field name="emailVerifiedDate" title="Email Verified">
            <display type="date-time"/>
        </field>
    </form>

    <!-- Member detail (read-only) -->
    <form name="ViewEfMember" type="single" default-map-name="efMember">
        <field name="partyId" title="Party ID">
            <display/>
        </field>
        <field name="userLoginId" title="Login / Email">
            <display/>
        </field>
        <field name="memberTypeEnumId" title="Member Type">
            <display/>
        </field>
        <field name="statusId" title="Status">
            <display/>
        </field>
        <field name="mfaMethodEnumId" title="MFA Method">
            <display/>
        </field>
        <field name="emailVerifiedDate" title="Email Verified">
            <display type="date-time"/>
        </field>
        <field name="lastLoginDate" title="Last Login">
            <display type="date-time"/>
        </field>
        <field name="createdDate" title="Registered">
            <display type="date-time"/>
        </field>
    </form>

    <!-- Unlock member (shown on member detail) -->
    <form name="UnlockEfMember" type="single" default-map-name="efMember" target="unlockEfMember">
        <field name="partyId" title="Party ID"><hidden/></field>
        <field name="submitButton" title="Unlock Account" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <!-- W3: KYC check list (read-only) -->
    <form name="ListEfKycChecks" type="list" list-name="efKycChecks"
          paginate-target="FindEfKycCheck">
        <field name="kycCheckId" title="KYC Check ID">
            <hyperlink description="${kycCheckId}" target="ViewEfKycCheck">
                <parameter param-name="kycCheckId" from-field="kycCheckId"/>
            </hyperlink>
        </field>
        <field name="memberPartyId" title="Member">
            <display/>
        </field>
        <field name="kycMethodEnumId" title="Method">
            <display/>
        </field>
        <field name="statusId" title="Status">
            <display/>
        </field>
        <field name="confirmerPartyId" title="Reviewer">
            <display/>
        </field>
        <field name="confirmedDate" title="Reviewed">
            <display type="date-time"/>
        </field>
        <field name="createdDate" title="Created">
            <display type="date-time"/>
        </field>
    </form>

    <!-- W3: KYC detail and staff review -->
    <form name="ViewEfKycCheck" type="single" default-map-name="efKycCheck"
          target="reviewEfKycCheck">
        <field name="kycCheckId" title="KYC Check ID"><hidden/></field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="kycSubjectPartyId" title="Subject Party"><display/></field>
        <field name="kycMethodEnumId" title="Method"><display/></field>
        <field name="confirmerPartyId" title="Reviewer"><display/></field>
        <field name="confirmedDate" title="Reviewed"><display type="date-time"/></field>
        <field name="createdDate" title="Created"><display type="date-time"/></field>
        <field name="statusId" title="Review Result">
            <drop-down allow-empty="false">
                <entity-options entity-name="StatusItem" key-field-name="statusId"
                                description="${description}">
                    <entity-constraint name="statusTypeId" operator="equals" value="EFKYC_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="confirmerNote" title="Reviewer Note">
            <text-line size="80"/>
        </field>
        <field name="submitButton" title="Save Review" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <form name="ListEfKycImages" type="list" list-name="efKycImages">
        <field name="kycImageId" title="Image ID"><display/></field>
        <field name="imageTypeEnumId" title="Type"><display/></field>
        <field name="contentId" title="Content"><display/></field>
        <field name="uploadedDate" title="Uploaded"><display type="date-time"/></field>
    </form>

    <!-- W4: additional document requests -->
    <form name="ListEfDocumentRequests" type="list" list-name="efDocumentRequests">
        <field name="docRequestId" title="Request ID"><display/></field>
        <field name="draftId" title="Application"><display/></field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="documentTypeEnumId" title="Document Type"><display/></field>
        <field name="statusId" title="Status"><display/></field>
        <field name="dueDate" title="Due"><display type="date-time"/></field>
        <field name="requestedDate" title="Requested"><display type="date-time"/></field>
        <field name="submittedDate" title="Submitted"><display type="date-time"/></field>
    </form>

    <!-- W6: service requests -->
    <form name="ListEfServiceRequests" type="list" list-name="efServiceRequests"
          paginate-target="FindEfServiceRequest">
        <field name="serviceRequestId" title="Request ID">
            <hyperlink description="${serviceRequestId}" target="ViewEfServiceRequest">
                <parameter param-name="serviceRequestId" from-field="serviceRequestId"/>
            </hyperlink>
        </field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="requestTypeEnumId" title="Type"><display/></field>
        <field name="statusId" title="Status"><display/></field>
        <field name="subject" title="Subject"><display/></field>
        <field name="assignedToPartyId" title="Assignee"><display/></field>
        <field name="requestedDate" title="Requested"><display type="date-time"/></field>
        <field name="completedDate" title="Completed"><display type="date-time"/></field>
    </form>

    <form name="ViewEfServiceRequest" type="single" default-map-name="efServiceRequest"
          target="updateEfServiceRequest">
        <field name="serviceRequestId" title="Request ID"><hidden/></field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="requestTypeEnumId" title="Type"><display/></field>
        <field name="agreementId" title="Contract"><display/></field>
        <field name="agreementTypeId" title="Contract Type"><display/></field>
        <field name="subject" title="Subject"><display/></field>
        <field name="content" title="Content"><display/></field>
        <field name="requestData" title="Request Data"><display/></field>
        <field name="requestedDate" title="Requested"><display type="date-time"/></field>
        <field name="completedDate" title="Completed"><display type="date-time"/></field>
        <field name="statusId" title="New Status">
            <drop-down allow-empty="true">
                <entity-options entity-name="StatusItem" key-field-name="statusId"
                                description="${description}">
                    <entity-constraint name="statusTypeId" operator="equals" value="EFSVCREQ_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="assignedToPartyId" title="Assignee"><text-line size="40"/></field>
        <field name="staffNotes" title="Staff Notes"><text-line size="80"/></field>
        <field name="submitButton" title="Update Request" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <!-- Audit log filter and list (read-only) -->
    <form name="FindEfAuditLog" type="single" target="FindEfAuditLog">
        <field name="partyId" title="Party ID"><text-line size="40"/></field>
        <field name="actionEnumId" title="Action">
            <drop-down allow-empty="true">
                <entity-options entity-name="Enumeration" key-field-name="enumId"
                                description="${description}">
                    <entity-constraint name="enumTypeId" operator="equals" value="EFAUDIT_ACTION"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="submitButton" title="Search" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <!-- W7 direct debit mandates -->
    <form name="ListEfDirectDebits" type="list" list-name="efDirectDebits"
          target="ViewEfDirectDebit">
        <field name="mandateId" title="Mandate ID">
            <hyperlink description="${mandateId}" target="ViewEfDirectDebit">
                <parameter param-name="mandateId" from-field="mandateId"/>
            </hyperlink>
        </field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="agreementId" title="Contract"><display/></field>
        <field name="bankName" title="Bank"><display/></field>
        <field name="branchName" title="Branch"><display/></field>
        <field name="accountNumberLast4" title="Account"><display/></field>
        <field name="statusId" title="Status"><display/></field>
        <field name="requestedDate" title="Requested"><display type="date-time"/></field>
    </form>

    <form name="UpdateEfDirectDebit" type="single" default-map-name="efDirectDebit"
          target="updateEfDirectDebit">
        <field name="mandateId" title="Mandate ID"><hidden/></field>
        <field name="memberPartyId" title="Member"><display/></field>
        <field name="agreementId" title="Contract"><display/></field>
        <field name="agreementTypeId" title="Contract Type"><display/></field>
        <field name="bankName" title="Bank"><display/></field>
        <field name="branchName" title="Branch"><display/></field>
        <field name="accountTypeEnumId" title="Account Type"><display/></field>
        <field name="accountNumberLast4" title="Account Last 4"><display/></field>
        <field name="accountHolderName" title="Account Holder"><display/></field>
        <field name="currentStatus" title="Current Status">
            <display description="${efDirectDebit.statusId}"/>
        </field>
        <field name="statusId" title="New Status">
            <drop-down allow-empty="true">
                <entity-options entity-name="StatusItem" key-field-name="statusId"
                                description="${description}">
                    <entity-constraint name="statusTypeId" operator="equals" value="EFDD_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="staffNote" title="Staff Note"><text-line size="80"/></field>
        <field name="submitButton" title="Update Mandate" widget-style="smallSubmit">
            <submit button-type="button"/>
        </field>
    </form>

    <form name="ListEfAuditLogs" type="list" list-name="auditLogs"
          paginate-target="FindEfAuditLog">
        <field name="auditLogId" title="Audit ID"><display/></field>
        <field name="actionDate" title="Date"><display type="date-time"/></field>
        <field name="partyId" title="Party"><display/></field>
        <field name="actionEnumId" title="Action"><display/></field>
        <field name="targetEntityName" title="Target"><display/></field>
        <field name="targetEntityId" title="Target ID"><display/></field>
        <field name="resultEnumId" title="Result"><display/></field>
        <field name="ipAddress" title="IP"><display/></field>
        <field name="detail" title="Detail"><display/></field>
    </form>

</forms>
