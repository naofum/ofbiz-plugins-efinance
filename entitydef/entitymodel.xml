<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>eFinance Component Entity Model</title>
    <description>
        Customer-facing portal entities for the eFinance plugin.
        Covers member accounts, corporate accounts, tokens, OTP, consent and audit log.
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- Member                                                    -->
    <!-- ========================================================= -->
    <entity entity-name="EfMember" package-name="org.apache.ofbiz.efinance.account"
            title="eFinance portal member">
        <field name="partyId" type="id"><description>FK to Party</description></field>
        <field name="userLoginId" type="id-vlong"><description>FK to UserLogin</description></field>
        <field name="memberTypeEnumId" type="id"><description>EFMBR_TYPE: PERSONAL, CORPORATE_USER</description></field>
        <field name="statusId" type="id"><description>EFMBR_STATUS</description></field>
        <field name="emailVerifiedDate" type="date-time"/>
        <field name="phoneVerifiedDate" type="date-time"/>
        <field name="mfaMethodEnumId" type="id"><description>EFMFA_METHOD: EMAIL, SMS, NONE</description></field>
        <field name="lastLoginDate" type="date-time"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="partyId"/>
        <relation type="one" fk-name="EFMBR_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="EFMBR_UL" rel-entity-name="UserLogin">
            <key-map field-name="userLoginId"/>
        </relation>
        <relation type="one" fk-name="EFMBR_STS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <index name="EFMBR_UL_IDX">
            <index-field name="userLoginId"/>
        </index>
        <index name="EFMBR_STS_IDX">
            <index-field name="statusId"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Corporate account                                         -->
    <!-- ========================================================= -->
    <entity entity-name="EfCorporateAccount" package-name="org.apache.ofbiz.efinance.account"
            title="eFinance corporate account">
        <field name="corporatePartyId" type="id"><description>FK to Party (PARTY_GROUP)</description></field>
        <field name="adminMemberId" type="id"><description>FK to EfMember (partyId)</description></field>
        <field name="statusId" type="id"><description>EFCORP_STATUS</description></field>
        <field name="createdDate" type="date-time"/>
        <prim-key field="corporatePartyId"/>
        <relation type="one" fk-name="EFCORP_PARTY" rel-entity-name="Party">
            <key-map field-name="corporatePartyId"/>
        </relation>
        <relation type="one" fk-name="EFCORP_STS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- Corporate user (member ↔ corporate account)              -->
    <!-- ========================================================= -->
    <entity entity-name="EfCorporateUser" package-name="org.apache.ofbiz.efinance.account"
            title="eFinance corporate user role">
        <field name="corporatePartyId" type="id"><description>FK to EfCorporateAccount</description></field>
        <field name="memberPartyId" type="id"><description>FK to EfMember</description></field>
        <field name="roleApply" type="indicator"><description>Y/N can submit applications</description></field>
        <field name="roleView" type="indicator"><description>Y/N can view contracts</description></field>
        <field name="rolePayment" type="indicator"><description>Y/N can manage payments</description></field>
        <field name="roleAdmin" type="indicator"><description>Y/N is corporate admin</description></field>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <prim-key field="corporatePartyId"/>
        <prim-key field="memberPartyId"/>
        <prim-key field="fromDate"/>
        <relation type="one" fk-name="EFCORPU_CORP" rel-entity-name="EfCorporateAccount">
            <key-map field-name="corporatePartyId"/>
        </relation>
        <relation type="one" fk-name="EFCORPU_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- One-time code (OTP)                                       -->
    <!-- ========================================================= -->
    <entity entity-name="EfOneTimeCode" package-name="org.apache.ofbiz.efinance.auth"
            title="eFinance one-time code / OTP" never-cache="true">
        <field name="otpId" type="id"><description>sequenced PK</description></field>
        <field name="partyId" type="id"><description>FK to Party</description></field>
        <field name="codeHash" type="value"><description>SHA-256 hash of the plain OTP</description></field>
        <field name="purposeEnumId" type="id"><description>EFOTP_PURPOSE</description></field>
        <field name="expiresAt" type="date-time"/>
        <field name="attemptCount" type="numeric"/>
        <field name="usedDate" type="date-time"/>
        <field name="createdDate" type="date-time"/>
        <prim-key field="otpId"/>
        <relation type="one" fk-name="EFOTP_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <index name="EFOTP_PARTY_PURPOSE_IDX">
            <index-field name="partyId"/>
            <index-field name="purposeEnumId"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Access token                                              -->
    <!-- ========================================================= -->
    <entity entity-name="EfToken" package-name="org.apache.ofbiz.efinance.auth"
            title="eFinance access token" never-cache="true">
        <field name="tokenId" type="id"><description>sequenced PK</description></field>
        <field name="tokenHash" type="value"><description>SHA-256 of the raw access token</description></field>
        <field name="partyId" type="id"><description>FK to Party</description></field>
        <field name="userLoginId" type="id-vlong"/>
        <field name="deviceId" type="short-varchar"/>
        <field name="ipAddress" type="short-varchar"/>
        <field name="issuedAt" type="date-time"/>
        <field name="expiresAt" type="date-time"/>
        <field name="revokedDate" type="date-time"/>
        <field name="detail" type="short-varchar"><description>e.g. MFA_TEMP flag</description></field>
        <prim-key field="tokenId"/>
        <relation type="one" fk-name="EFTKN_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <index name="EFTKN_PARTY_IDX">
            <index-field name="partyId"/>
        </index>
        <index name="EFTKN_EXPIRES_IDX">
            <index-field name="expiresAt"/>
        </index>
        <index name="EFTKN_HASH_IDX" unique="true">
            <index-field name="tokenHash"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Refresh token                                             -->
    <!-- ========================================================= -->
    <entity entity-name="EfRefreshToken" package-name="org.apache.ofbiz.efinance.auth"
            title="eFinance refresh token" never-cache="true">
        <field name="refreshTokenId" type="id"><description>sequenced PK</description></field>
        <field name="tokenHash" type="value"><description>SHA-256 of the raw refresh token</description></field>
        <field name="partyId" type="id"><description>FK to Party</description></field>
        <field name="userLoginId" type="id-vlong"/>
        <field name="deviceId" type="short-varchar"/>
        <field name="issuedAt" type="date-time"/>
        <field name="expiresAt" type="date-time"/>
        <field name="revokedDate" type="date-time"/>
        <field name="replacedByTokenId" type="id"><description>FK to EfRefreshToken for rotation chain</description></field>
        <prim-key field="refreshTokenId"/>
        <relation type="one" fk-name="EFRFTKN_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <index name="EFRFTKN_PARTY_IDX">
            <index-field name="partyId"/>
        </index>
        <index name="EFRFTKN_HASH_IDX" unique="true">
            <index-field name="tokenHash"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Consent document                                          -->
    <!-- ========================================================= -->
    <entity entity-name="EfConsentDocument" package-name="org.apache.ofbiz.efinance.consent"
            title="eFinance consent document version">
        <field name="documentId" type="id"><description>sequenced PK</description></field>
        <field name="documentTypeEnumId" type="id"><description>EFCONSENT_TYPE</description></field>
        <field name="version" type="short-varchar"/>
        <field name="language" type="short-varchar"/>
        <field name="contentId" type="id"><description>FK to Content</description></field>
        <field name="effectiveDate" type="date-time"/>
        <field name="expiresDate" type="date-time"/>
        <prim-key field="documentId"/>
        <relation type="one" fk-name="EFCDOC_CTN" rel-entity-name="Content">
            <key-map field-name="contentId"/>
        </relation>
        <index name="EFCDOC_TYPE_VER_IDX">
            <index-field name="documentTypeEnumId"/>
            <index-field name="version"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Consent record                                            -->
    <!-- ========================================================= -->
    <entity entity-name="EfConsent" package-name="org.apache.ofbiz.efinance.consent"
            title="eFinance consent record">
        <field name="consentId" type="id"><description>sequenced PK</description></field>
        <field name="partyId" type="id"><description>FK to Party</description></field>
        <field name="documentId" type="id"><description>FK to EfConsentDocument</description></field>
        <field name="consentDate" type="date-time"/>
        <field name="ipAddress" type="short-varchar"/>
        <field name="deviceId" type="short-varchar"/>
        <field name="revokedDate" type="date-time"/>
        <prim-key field="consentId"/>
        <relation type="one" fk-name="EFCNS_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="EFCNS_DOC" rel-entity-name="EfConsentDocument">
            <key-map field-name="documentId"/>
        </relation>
        <index name="EFCNS_PARTY_IDX">
            <index-field name="partyId"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- Product publication (W1)                                 -->
    <!-- ========================================================= -->
    <!-- EfProductPublication: controls which FinancialProducts are visible on the portal -->
    <entity entity-name="EfProductPublication" package-name="org.apache.ofbiz.efinance.catalog"
            title="eFinance product publication">
        <field name="publicationId" type="id"><description>sequenced</description></field>
        <field name="productId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <field name="displayOrder" type="numeric"/>
        <field name="targetEnumId" type="id"><description>EFPROD_TARGET: PERSONAL, CORPORATE, ALL</description></field>
        <field name="active" type="indicator"/>
        <prim-key field="publicationId"/>
        <relation type="one" fk-name="EFPUB_PROD" rel-entity-name="FinancialProduct">
            <key-map field-name="productId"/>
        </relation>
        <index name="EFPUB_PROD_IDX"><index-field name="productId"/></index>
        <index name="EFPUB_ACTIVE_IDX"><index-field name="active"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W2 Application draft                                     -->
    <!-- ========================================================= -->
    <entity entity-name="EfApplicationDraft" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance application draft">
        <field name="draftId" type="id"><description>sequenced</description></field>
        <field name="memberPartyId" type="id"><description>EfMember.partyId</description></field>
        <field name="corporatePartyId" type="id"><description>for corporate applications</description></field>
        <field name="productId" type="id"/>
        <field name="applicationTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="currentStep" type="numeric"><description>1-based step number</description></field>
        <field name="totalSteps" type="numeric"/>
        <field name="draftJson" type="very-long"><description>JSON blob of all step data</description></field>
        <field name="statusId" type="id"><description>EFDRF_EDITING, EFDRF_SUBMITTED, EFDRF_EXPIRED, EFDRF_WITHDRAWN</description></field>
        <field name="sourceEnumId" type="id"><description>EFSRC_DIRECT, EFSRC_PARTNER etc.</description></field>
        <field name="submittedApplicationId" type="id"><description>finance loanApplicationId or leaseApplicationId after submission</description></field>
        <field name="submittedApplicationTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="expiresAt" type="date-time"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="draftId"/>
        <relation type="one" fk-name="EFDRF_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" title="Product" rel-entity-name="FinancialProduct">
            <key-map field-name="productId"/>
        </relation>
        <index name="EFDRF_MBR_IDX"><index-field name="memberPartyId"/></index>
        <index name="EFDRF_PROD_IDX"><index-field name="productId"/></index>
        <index name="EFDRF_STS_IDX"><index-field name="statusId"/></index>
    </entity>

    <entity entity-name="EfDraftDocument" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance draft document attachment">
        <field name="draftDocumentId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="contentId" type="id"><description>FK to Content</description></field>
        <field name="documentTypeEnumId" type="id"><description>EFDOC_TYPE: ID_FRONT, ID_BACK, INCOME_PROOF, CORPORATE_REGISTRY, etc.</description></field>
        <field name="fileName" type="short-varchar"/>
        <field name="mimeTypeId" type="id"/>
        <field name="fileSizeBytes" type="numeric"/>
        <field name="scanStatus" type="id"><description>EFSCAN_PENDING, EFSCAN_OK, EFSCAN_INFECTED</description></field>
        <field name="uploadedDate" type="date-time"/>
        <prim-key field="draftDocumentId"/>
        <relation type="one" fk-name="EFDRFDOC_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one-nofk" fk-name="EFDRFDOC_CTN" rel-entity-name="Content">
            <key-map field-name="contentId"/>
        </relation>
        <index name="EFDRFDOC_DRF_IDX"><index-field name="draftId"/></index>
    </entity>

    <entity entity-name="EfApplicationLink" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance draft to finance application link">
        <field name="linkId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="corporatePartyId" type="id"/>
        <field name="financeApplicationId" type="id"><description>loanApplicationId or leaseApplicationId</description></field>
        <field name="financeApplicationTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="linkedDate" type="date-time"/>
        <prim-key field="linkId"/>
        <relation type="one-nofk" fk-name="EFLINK_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFLINK_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFLINK_MBR_IDX"><index-field name="memberPartyId"/></index>
        <index name="EFLINK_DRF_IDX"><index-field name="draftId"/></index>
    </entity>

    <entity entity-name="EfFraudCheck" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance fraud check result">
        <field name="fraudCheckId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="checkDate" type="date-time"/>
        <field name="resultEnumId" type="id"><description>EFFRAUD_OK, EFFRAUD_REVIEW, EFFRAUD_BLOCK</description></field>
        <field name="triggeredRules" type="short-varchar"><description>comma-separated rule codes</description></field>
        <field name="ipAddress" type="short-varchar"/>
        <field name="deviceId" type="short-varchar"/>
        <prim-key field="fraudCheckId"/>
        <relation type="one-nofk" fk-name="EFFRAUD_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFFRAUD_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFFRAUD_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFFRAUD_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W3 KYC check                                             -->
    <!-- ========================================================= -->
    <entity entity-name="EfKycCheck" package-name="org.apache.ofbiz.efinance.kyc"
            title="eFinance KYC identity verification check">
        <field name="kycCheckId" type="id"><description>sequenced</description></field>
        <field name="memberPartyId" type="id"/>
        <field name="kycSubjectPartyId" type="id"><description>individual being verified (may differ for corporate representative)</description></field>
        <field name="draftId" type="id"><description>associated application draft if any</description></field>
        <field name="kycMethodEnumId" type="id"><description>EFKYC_METHOD enum</description></field>
        <field name="statusId" type="id"><description>EFKYC_STATUS: EFKYC_PENDING, EFKYC_SUBMITTED, EFKYC_VERIFIED, EFKYC_RESUBMIT, EFKYC_REJECTED</description></field>
        <field name="confirmerPartyId" type="id"><description>staff who confirmed; null for automatic</description></field>
        <field name="confirmedDate" type="date-time"/>
        <field name="confirmerNote" type="comment"/>
        <field name="adapterResultCode" type="short-varchar"><description>result code from EkycAdapter</description></field>
        <field name="adapterExternalId" type="short-varchar"/>
        <field name="expiresDate" type="date-time"><description>legal retention expiry</description></field>
        <field name="createdDate" type="date-time"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="kycCheckId"/>
        <relation type="one" fk-name="EFKYC_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="EFKYC_SUBJ" rel-entity-name="Party">
            <key-map field-name="kycSubjectPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <index name="EFKYC_MBR_IDX"><index-field name="memberPartyId"/></index>
        <index name="EFKYC_SUBJ_IDX"><index-field name="kycSubjectPartyId"/></index>
        <index name="EFKYC_STS_IDX"><index-field name="statusId"/></index>
    </entity>

    <entity entity-name="EfKycImage" package-name="org.apache.ofbiz.efinance.kyc"
            title="eFinance KYC image attachment">
        <field name="kycImageId" type="id"><description>sequenced</description></field>
        <field name="kycCheckId" type="id"/>
        <field name="contentId" type="id"/>
        <field name="imageTypeEnumId" type="id"><description>EFKYC_IMG_TYPE: ID_DOC_FRONT, ID_DOC_BACK, FACIAL, IC_CHIP_DATA</description></field>
        <field name="uploadedDate" type="date-time"/>
        <prim-key field="kycImageId"/>
        <relation type="one" fk-name="EFKYCIMG_KYC" rel-entity-name="EfKycCheck">
            <key-map field-name="kycCheckId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="Content">
            <key-map field-name="contentId"/>
        </relation>
        <index name="EFKYCIMG_KYC_IDX"><index-field name="kycCheckId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W4 Pre-screen result (internal only)                     -->
    <!-- ========================================================= -->
    <entity entity-name="EfPreScreenResult" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance pre-screen result">
        <field name="preScreenId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="preScreenDate" type="date-time"/>
        <field name="resultEnumId" type="id"><description>EFPRE_LIKELY, EFPRE_CONSULT, EFPRE_UNLIKELY</description></field>
        <field name="triggeredRules" type="short-varchar"><description>internal: comma-separated rule codes fired</description></field>
        <field name="inputSummary" type="short-varchar"><description>non-PII summary e.g. amount=300000,term=24</description></field>
        <prim-key field="preScreenId"/>
        <relation type="one" fk-name="EFPRE_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFPRE_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFPRE_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFPRE_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W4 Stage event for notification                          -->
    <!-- ========================================================= -->
    <entity entity-name="EfStageEvent" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance application stage change event">
        <field name="stageEventId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="fromStageEnumId" type="id"/>
        <field name="toStageEnumId" type="id"/>
        <field name="eventDate" type="date-time"/>
        <field name="notified" type="indicator"/>
        <prim-key field="stageEventId"/>
        <relation type="one" fk-name="EFSTEV_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFSTEV_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFSTEV_DRF_IDX"><index-field name="draftId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W4 Additional document request                           -->
    <!-- ========================================================= -->
    <entity entity-name="EfDocumentRequest" package-name="org.apache.ofbiz.efinance.application"
            title="eFinance additional document request">
        <field name="docRequestId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="documentTypeEnumId" type="id"/>
        <field name="reason" type="comment"/>
        <field name="dueDate" type="date-time"/>
        <field name="statusId" type="id"><description>EFDOCREQ_PENDING, EFDOCREQ_SUBMITTED, EFDOCREQ_ACCEPTED, EFDOCREQ_REJECTED</description></field>
        <field name="requestedByPartyId" type="id"/>
        <field name="requestedDate" type="date-time"/>
        <field name="submittedContentId" type="id"><description>Content when document is submitted</description></field>
        <field name="submittedDate" type="date-time"/>
        <prim-key field="docRequestId"/>
        <relation type="one" fk-name="EFDOCREQ_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFDOCREQ_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFDOCREQ_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFDOCREQ_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W5 Signing session                                       -->
    <!-- ========================================================= -->
    <entity entity-name="EfSigningSession" package-name="org.apache.ofbiz.efinance.contract"
            title="eFinance signing session">
        <field name="signingSessionId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="quoteId" type="id"><description>loanQuoteId or leaseQuoteId</description></field>
        <field name="quoteTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="statusId" type="id"><description>EFSIG_PENDING, EFSIG_SIGNED, EFSIG_DECLINED, EFSIG_EXPIRED</description></field>
        <field name="consentIpAddress" type="short-varchar"/>
        <field name="consentDeviceId" type="short-varchar"/>
        <field name="consentDate" type="date-time"/>
        <field name="signatureMethodEnumId" type="id"><description>EFSIG_METHOD</description></field>
        <field name="signatureEvidenceHash" type="short-varchar"><description>hash of the signature evidence</description></field>
        <field name="signedContentId" type="id"><description>Content: record of consent (text/hash)</description></field>
        <field name="agreementId" type="id"><description>loanAgreementId or leaseAgreementId after successful signing</description></field>
        <field name="agreementTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="expiresAt" type="date-time"/>
        <field name="createdDate" type="date-time"/>
        <prim-key field="signingSessionId"/>
        <relation type="one" fk-name="EFSIG_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFSIG_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFSIG_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFSIG_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W5 Delivered document                                    -->
    <!-- ========================================================= -->
    <entity entity-name="EfDeliveredDocument" package-name="org.apache.ofbiz.efinance.contract"
            title="eFinance delivered document">
        <field name="deliveredDocId" type="id"><description>sequenced</description></field>
        <field name="draftId" type="id"/>
        <field name="memberPartyId" type="id"/>
        <field name="documentTypeEnumId" type="id"><description>EFDELDOC_TYPE enum</description></field>
        <field name="contentId" type="id"/>
        <field name="deliveredDate" type="date-time"/>
        <field name="consentId" type="id"><description>EfConsent for electronic delivery consent</description></field>
        <field name="viewedDate" type="date-time"/>
        <prim-key field="deliveredDocId"/>
        <relation type="one" fk-name="EFDELDOC_DRF" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <relation type="one" fk-name="EFDELDOC_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" fk-name="EFDELDOC_CTN" rel-entity-name="Content">
            <key-map field-name="contentId"/>
        </relation>
        <index name="EFDELDOC_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFDELDOC_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W6 Service request                                       -->
    <!-- ========================================================= -->
    <entity entity-name="EfServiceRequest" package-name="org.apache.ofbiz.efinance.mypage"
            title="eFinance post-contract service request">
        <field name="serviceRequestId" type="id"><description>sequenced</description></field>
        <field name="memberPartyId" type="id"/>
        <field name="draftId" type="id"><description>related application draft</description></field>
        <field name="agreementId" type="id"><description>loanAgreementId or leaseAgreementId</description></field>
        <field name="agreementTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="requestTypeEnumId" type="id"><description>EFSVCREQ_TYPE enum</description></field>
        <field name="statusId" type="id"><description>EFSVCREQ_STATUS</description></field>
        <field name="subject" type="short-varchar"/>
        <field name="content" type="description"/>
        <field name="requestData" type="very-long"><description>JSON: type-specific request parameters</description></field>
        <field name="requestedByPartyId" type="id"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="requestedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="staffNotes" type="comment"/>
        <prim-key field="serviceRequestId"/>
        <relation type="one" fk-name="EFSVCREQ_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="EfApplicationDraft">
            <key-map field-name="draftId"/>
        </relation>
        <index name="EFSVCREQ_MBR_IDX"><index-field name="memberPartyId"/></index>
        <index name="EFSVCREQ_DRF_IDX"><index-field name="draftId"/></index>
        <index name="EFSVCREQ_STS_IDX"><index-field name="statusId"/></index>
    </entity>

    <!-- W6 Notification settings -->
    <entity entity-name="EfNotificationSetting" package-name="org.apache.ofbiz.efinance.mypage"
            title="eFinance member notification settings">
        <field name="memberPartyId" type="id"/>
        <field name="notificationTypeEnumId" type="id"/>
        <field name="emailEnabled" type="indicator"/>
        <field name="smsEnabled" type="indicator"/>
        <field name="pushEnabled" type="indicator"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="memberPartyId"/>
        <prim-key field="notificationTypeEnumId"/>
        <relation type="one" fk-name="EFNOTSET_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="EFNOTSET_MBR_IDX"><index-field name="memberPartyId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- W7 Direct debit mandate                                   -->
    <!-- ========================================================= -->
    <entity entity-name="EfDirectDebitMandate" package-name="org.apache.ofbiz.efinance.payment"
            title="eFinance direct debit mandate">
        <field name="mandateId" type="id"><description>sequenced PK</description></field>
        <field name="memberPartyId" type="id"><description>FK to Party</description></field>
        <field name="agreementId" type="id"><description>loanAgreementId or leaseAgreementId</description></field>
        <field name="agreementTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="financeContractId" type="id"><description>common finance contract id when known</description></field>
        <field name="bankName" type="short-varchar"/>
        <field name="branchName" type="short-varchar"/>
        <field name="accountTypeEnumId" type="id"><description>EFDD_ACCOUNT_TYPE</description></field>
        <field name="accountNumber" type="long-varchar" encrypt="true"/>
        <field name="accountNumberLast4" type="short-varchar"/>
        <field name="accountHolderName" type="short-varchar"/>
        <field name="statusId" type="id"><description>EFDD_STATUS</description></field>
        <field name="adapterResult" type="short-varchar"/>
        <field name="startDate" type="date-time"/>
        <field name="requestedDate" type="date-time"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="mandateId"/>
        <relation type="one" fk-name="EFDD_MBR" rel-entity-name="Party">
            <key-map field-name="memberPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="EFDD_STS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <index name="EFDD_MBR_IDX"><index-field name="memberPartyId"/></index>
        <index name="EFDD_AGR_IDX"><index-field name="agreementId"/></index>
        <index name="EFDD_STS_IDX"><index-field name="statusId"/></index>
    </entity>

    <!-- ========================================================= -->
    <!-- Audit log                                                 -->
    <!-- ========================================================= -->
    <entity entity-name="EfAuditLog" package-name="org.apache.ofbiz.efinance.audit"
            title="eFinance audit log" never-cache="true">
        <field name="auditLogId" type="id"><description>sequenced PK</description></field>
        <field name="partyId" type="id"><description>FK to Party (nullable)</description></field>
        <field name="actionEnumId" type="id"><description>EFAUDIT_ACTION</description></field>
        <field name="targetEntityName" type="short-varchar"/>
        <field name="targetEntityId" type="id"/>
        <field name="resultEnumId" type="id"><description>EFAUDIT_RESULT</description></field>
        <field name="ipAddress" type="short-varchar"/>
        <field name="deviceId" type="short-varchar"/>
        <field name="actionDate" type="date-time"/>
        <field name="detail" type="short-varchar"/>
        <prim-key field="auditLogId"/>
        <relation type="one-nofk" fk-name="EFAUD_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <index name="EFAUD_PARTY_IDX">
            <index-field name="partyId"/>
        </index>
        <index name="EFAUD_DATE_IDX">
            <index-field name="actionDate"/>
        </index>
    </entity>

</entitymodel>
