<api name="efinance" displayName="eFinance Customer API"
     description="eFinance customer portal REST API"
     publish="true"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/rest-api.xsd">

    <!-- Authentication -->
    <resource name="register" path="/ef/auth/register" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efRegisterMember"/>
        </operation>
    </resource>

    <resource name="verifyEmail" path="/ef/auth/verify-email" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efVerifyEmail"/>
        </operation>
    </resource>

    <resource name="login" path="/ef/auth/login" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efLogin"/>
        </operation>
    </resource>

    <resource name="verifyMfa" path="/ef/auth/verify-mfa" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efVerifyMfa"/>
        </operation>
    </resource>

    <resource name="reauthenticate" path="/ef/auth/reauth" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efReauthenticate"/>
        </operation>
    </resource>

    <resource name="refreshToken" path="/ef/auth/refresh" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efRefreshToken"/>
        </operation>
    </resource>

    <resource name="logout" path="/ef/auth/logout" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efLogout"/>
        </operation>
    </resource>

    <resource name="logoutAll" path="/ef/auth/logout-all" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efLogoutAll"/>
        </operation>
    </resource>

    <resource name="passwordResetRequest" path="/ef/auth/password-reset" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efRequestPasswordReset"/>
        </operation>
    </resource>

    <resource name="passwordReset" path="/ef/auth/password-reset/confirm" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efResetPassword"/>
        </operation>
    </resource>

    <!-- Profile -->
    <resource name="profile" path="/ef/me" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetProfile"/>
        </operation>
    </resource>

    <!-- Consents -->
    <resource name="consents" path="/ef/consents" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListConsents"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efAcceptConsent"/>
        </operation>
    </resource>
    <resource name="consentDocuments" path="/ef/consent-documents" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListConsentDocuments"/>
        </operation>
    </resource>

    <!-- W1: Product catalog (no auth) -->
    <resource name="products" path="/ef/products" auth="false">
        <operation verb="get" produces="application/json" auth="false">
            <service name="efListProducts"/>
        </operation>
    </resource>
    <resource name="product" path="/ef/products/{productId}" auth="false">
        <operation verb="get" produces="application/json" auth="false">
            <service name="efGetProduct"/>
        </operation>
    </resource>
    <resource name="simulateLoan" path="/ef/simulate/loan" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efSimulateLoan"/>
        </operation>
    </resource>
    <resource name="simulateLease" path="/ef/simulate/lease" auth="false">
        <operation verb="post" consumes="application/json" produces="application/json" auth="false">
            <service name="efSimulateLease"/>
        </operation>
    </resource>
    <!-- W2: Application form schema -->
    <resource name="applicationForm" path="/ef/applications/form" auth="false">
        <operation verb="get" produces="application/json" auth="false">
            <service name="efGetApplicationForm"/>
        </operation>
    </resource>
    <!-- W2: Draft operations -->
    <resource name="drafts" path="/ef/applications/drafts" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListDrafts"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efCreateDraft"/>
        </operation>
    </resource>
    <resource name="draft" path="/ef/applications/drafts/{draftId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetDraft"/>
        </operation>
        <operation verb="put" consumes="application/json" produces="application/json">
            <service name="efSaveDraft"/>
        </operation>
        <operation verb="delete" produces="application/json">
            <service name="efWithdrawDraft"/>
        </operation>
    </resource>
    <resource name="draftDocuments" path="/ef/applications/drafts/{draftId}/documents" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efUploadDraftDocument"/>
        </operation>
    </resource>
    <resource name="draftDocument" path="/ef/applications/drafts/{draftId}/documents/{draftDocumentId}" auth="true">
        <operation verb="delete" produces="application/json">
            <service name="efDeleteDraftDocument"/>
        </operation>
    </resource>
    <resource name="submitApplication" path="/ef/applications/drafts/{draftId}/submit" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efSubmitApplication"/>
        </operation>
    </resource>

    <!-- W3: KYC identity verification -->
    <resource name="kycStart" path="/ef/kyc" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efStartKyc"/>
        </operation>
    </resource>
    <resource name="kycStatus" path="/ef/kyc/{kycCheckId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetKycStatus"/>
        </operation>
    </resource>
    <resource name="kycImages" path="/ef/kyc/{kycCheckId}/images" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efUploadKycImage"/>
        </operation>
    </resource>
    <resource name="kycSubmit" path="/ef/kyc/{kycCheckId}/submit" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efSubmitKyc"/>
        </operation>
    </resource>

    <!-- W4: Pre-screen and application status -->
    <resource name="preScreen" path="/ef/applications/drafts/{draftId}/prescreen" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efPreScreen"/>
        </operation>
    </resource>
    <resource name="applicationStatus" path="/ef/applications/drafts/{draftId}/status" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetApplicationStatus"/>
        </operation>
    </resource>
    <resource name="applicationStageEvents" path="/ef/applications/drafts/{draftId}/stage-events" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListStageEvents"/>
        </operation>
    </resource>
    <resource name="documentRequests" path="/ef/applications/drafts/{draftId}/document-requests" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListDocumentRequests"/>
        </operation>
    </resource>
    <resource name="submitDocumentRequest" path="/ef/applications/drafts/{draftId}/document-requests/{docRequestId}/submit" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efSubmitRequestedDocument"/>
        </operation>
    </resource>

    <!-- W5: Contract -->
    <resource name="offer" path="/ef/applications/drafts/{draftId}/offer" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetOffer"/>
        </operation>
    </resource>
    <resource name="acceptOffer" path="/ef/applications/drafts/{draftId}/offer/accept" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efAcceptOffer"/>
        </operation>
    </resource>
    <resource name="signing" path="/ef/applications/drafts/{draftId}/signing" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efStartSigning"/>
        </operation>
    </resource>
    <resource name="signingComplete" path="/ef/signing/{signingSessionId}/complete" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efCompleteSigning"/>
        </operation>
    </resource>
    <resource name="documents" path="/ef/applications/drafts/{draftId}/documents" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListDocuments"/>
        </operation>
    </resource>
    <resource name="downloadDocument" path="/ef/documents/{deliveredDocId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efDownloadDocument"/>
        </operation>
    </resource>

    <!-- W6: MyPage -->
    <resource name="meApplications" path="/ef/me/applications" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListApplications"/>
        </operation>
    </resource>
    <resource name="meContracts" path="/ef/me/contracts" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListContracts"/>
        </operation>
    </resource>
    <resource name="meContract" path="/ef/me/contracts/{agreementId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetContract"/>
        </operation>
    </resource>
    <resource name="prepaymentSimulate" path="/ef/me/contracts/{agreementId}/prepayment/simulate" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efSimulatePrepayment"/>
        </operation>
    </resource>
    <resource name="prepaymentRequest" path="/ef/me/contracts/{agreementId}/prepayment" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRequestPrepayment"/>
        </operation>
    </resource>
    <resource name="modification" path="/ef/me/contracts/{agreementId}/modification" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRequestModification"/>
        </operation>
    </resource>
    <resource name="expiryOption" path="/ef/me/contracts/{agreementId}/expiry-option" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRequestExpiryOption"/>
        </operation>
    </resource>
    <resource name="profileChange" path="/ef/me/profile-change" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRequestProfileChange"/>
        </operation>
    </resource>
    <resource name="certificate" path="/ef/me/contracts/{agreementId}/certificate" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efRequestCertificate"/>
        </operation>
    </resource>
    <resource name="messages" path="/ef/me/messages" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListMessages"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efSendMessage"/>
        </operation>
    </resource>
    <resource name="notificationSettings" path="/ef/me/notification-settings" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetNotificationSettings"/>
        </operation>
        <operation verb="put" consumes="application/json" produces="application/json">
            <service name="efUpdateNotificationSettings"/>
        </operation>
    </resource>

    <!-- corporate accounts -->
    <resource name="directDebit" path="/ef/me/direct-debit" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetDirectDebit"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRequestDirectDebit"/>
        </operation>
    </resource>

    <resource name="paymentInstructions" path="/ef/me/payment-instructions" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetPaymentInstructions"/>
        </operation>
    </resource>

    <resource name="corporateAccounts" path="/ef/corporate/accounts" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListCorporateAccounts"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efCreateCorporateAccount"/>
        </operation>
    </resource>
    <resource name="corporateUsers" path="/ef/corporate/accounts/{corporatePartyId}/users" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListCorporateUsers"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efAddCorporateUser"/>
        </operation>
    </resource>
    <resource name="corporateUser" path="/ef/corporate/accounts/{corporatePartyId}/users/{memberPartyId}" auth="true">
        <operation verb="put" consumes="application/json" produces="application/json">
            <service name="efUpdateCorporateUser"/>
        </operation>
    </resource>

    <!-- support integration (efinance is the customer-facing gateway) -->
    <resource name="supportCases" path="/ef/support/cases" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efListSupportCases"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efCreateSupportCase"/>
        </operation>
    </resource>
    <resource name="supportCase" path="/ef/support/cases/{supportCaseId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetSupportCase"/>
        </operation>
    </resource>
    <resource name="supportMessages" path="/ef/support/cases/{supportCaseId}/messages" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efReplySupportCase"/>
        </operation>
    </resource>
    <resource name="supportClose" path="/ef/support/cases/{supportCaseId}/close" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efCloseSupportCase"/>
        </operation>
    </resource>
    <resource name="supportRating" path="/ef/support/cases/{supportCaseId}/rating" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="efRateSupportCase"/>
        </operation>
    </resource>
    <resource name="supportFormOptions" path="/ef/support/form-options" auth="true">
        <operation verb="get" produces="application/json">
            <service name="efGetSupportFormOptions"/>
        </operation>
    </resource>
    <resource name="supportAttachments" path="/ef/support/attachments" auth="true">
        <operation verb="post" produces="application/json">
            <service name="efUploadSupportAttachment"/>
        </operation>
    </resource>
</api>
