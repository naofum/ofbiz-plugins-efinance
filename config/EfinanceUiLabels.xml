<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-properties.xsd">

    <property key="EfinancePermissionError">
        <value xml:lang="en">You do not have permission to perform this operation.</value>
        <value xml:lang="ja">権限がありません。</value>
    </property>

    <property key="EfinanceMemberRegistered">
        <value xml:lang="en">Registration successful. Please check your email to verify your address.</value>
        <value xml:lang="ja">登録完了。メールアドレス確認メールをご確認ください。</value>
    </property>

    <property key="EfinanceEmailVerified">
        <value xml:lang="en">Email address verified successfully.</value>
        <value xml:lang="ja">メールアドレスを確認しました。</value>
    </property>

    <property key="EfinanceLoginSuccess">
        <value xml:lang="en">Login successful.</value>
        <value xml:lang="ja">ログイン成功。</value>
    </property>

    <property key="EfinanceLoginFailed">
        <value xml:lang="en">Login failed. Please check your credentials.</value>
        <value xml:lang="ja">ログインに失敗しました。認証情報をご確認ください。</value>
    </property>

    <property key="EfinanceMemberLocked">
        <value xml:lang="en">Your account has been locked. Please contact support.</value>
        <value xml:lang="ja">アカウントがロックされています。サポートにお問い合わせください。</value>
    </property>

    <property key="EfinanceMemberNotFound">
        <value xml:lang="en">Member account not found.</value>
        <value xml:lang="ja">会員が見つかりません。</value>
    </property>

    <property key="EfinanceMemberNotActive">
        <value xml:lang="en">Account is not active. Please verify your email address first.</value>
        <value xml:lang="ja">アカウントが有効ではありません。メールアドレスを確認してください。</value>
    </property>

    <property key="EfinanceTokenInvalid">
        <value xml:lang="en">Token is invalid or has expired.</value>
        <value xml:lang="ja">トークンが無効または期限切れです。</value>
    </property>

    <property key="EfinanceOtpInvalid">
        <value xml:lang="en">One-time password is invalid or has expired.</value>
        <value xml:lang="ja">ワンタイムパスワードが無効または期限切れです。</value>
    </property>

    <property key="EfinancePasswordResetSent">
        <value xml:lang="en">If the email address is registered, a password reset message has been sent.</value>
        <value xml:lang="ja">登録済みのメールアドレスにパスワード再設定メールを送信しました。</value>
    </property>

    <property key="EfinancePasswordReset">
        <value xml:lang="en">Password has been reset successfully.</value>
        <value xml:lang="ja">パスワードを再設定しました。</value>
    </property>

    <property key="EfinanceMfaRequired">
        <value xml:lang="en">Multi-factor authentication is required. Please enter your OTP.</value>
        <value xml:lang="ja">多要素認証が必要です。ワンタイムパスワードを入力してください。</value>
    </property>

    <property key="EfinanceConsentRecorded">
        <value xml:lang="en">Your consent has been recorded.</value>
        <value xml:lang="ja">同意を記録しました。</value>
    </property>

    <property key="EfinanceEmailAlreadyRegistered">
        <value xml:lang="en">This email address is already registered.</value>
        <value xml:lang="ja">このメールアドレスはすでに登録されています。</value>
    </property>

</resource>
