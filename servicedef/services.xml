<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">

    <description>eFinance W0 service definitions</description>

    <!-- ========================================================= -->
    <!-- Permission                                                -->
    <!-- ========================================================= -->
    <service name="efinanceAdminPermission" engine="simple" auth="true" export="false"
             location="component://efinance/minilang/EfinancePermissionServices.xml"
             invoke="efinanceAdminPermission">
        <description>Check whether the current user has EFINANCE_ADMIN permission</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="false"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ========================================================= -->
    <!-- Member registration and authentication                    -->
    <!-- ========================================================= -->
    <service name="efRegisterMember" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efRegisterMember">
        <description>Register a new portal member. Creates Party, UserLogin and EfMember.</description>
        <attribute name="email" type="String" mode="IN" optional="false"/>
        <attribute name="password" type="String" mode="IN" optional="false"/>
        <attribute name="firstName" type="String" mode="IN" optional="false"/>
        <attribute name="lastName" type="String" mode="IN" optional="true"/>
        <attribute name="phone" type="String" mode="IN" optional="true"/>
        <attribute name="memberType" type="String" mode="IN" optional="true"/>
        <attribute name="partyId" type="String" mode="OUT" optional="true"/>
        <attribute name="userLoginId" type="String" mode="OUT" optional="true"/>
        <attribute name="verificationToken" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efVerifyEmail" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efVerifyEmail">
        <description>Verify the member's email address with the OTP token.</description>
        <attribute name="token" type="String" mode="IN" optional="false"/>
        <attribute name="success" type="Boolean" mode="OUT" optional="true"/>
    </service>

    <service name="efLogin" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efLogin">
        <description>Authenticate a portal member. Returns JWT access token and refresh token, or MFA challenge.</description>
        <attribute name="userLoginId" type="String" mode="IN" optional="false"/>
        <attribute name="password" type="String" mode="IN" optional="false"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
        <attribute name="ipAddress" type="String" mode="IN" optional="true"/>
        <attribute name="accessToken" type="String" mode="OUT" optional="true"/>
        <attribute name="refreshToken" type="String" mode="OUT" optional="true"/>
        <attribute name="mfaRequired" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="mfaTempToken" type="String" mode="OUT" optional="true"/>
        <attribute name="memberStatus" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efVerifyMfa" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efVerifyMfa">
        <description>Complete MFA verification and obtain tokens.</description>
        <attribute name="tempToken" type="String" mode="IN" optional="false"/>
        <attribute name="otpCode" type="String" mode="IN" optional="false"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
        <attribute name="ipAddress" type="String" mode="IN" optional="true"/>
        <attribute name="accessToken" type="String" mode="OUT" optional="true"/>
        <attribute name="refreshToken" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efRefreshToken" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efRefreshToken">
        <description>Rotate the refresh token and issue a new access token.</description>
        <attribute name="refreshToken" type="String" mode="IN" optional="false"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
        <attribute name="accessToken" type="String" mode="OUT" optional="true"/>
        <attribute name="refreshToken" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efLogout" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efLogout">
        <description>Revoke the specified refresh token (logout from current device).</description>
        <attribute name="refreshToken" type="String" mode="IN" optional="true"/>
    </service>

    <service name="efLogoutAll" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efLogoutAll">
        <description>Revoke all active tokens for the authenticated member (logout from all devices).</description>
    </service>

    <service name="efRequestPasswordReset" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efRequestPasswordReset">
        <description>Generate a password-reset OTP and send it (stub: stored in DB).</description>
        <attribute name="email" type="String" mode="IN" optional="false"/>
    </service>

    <service name="efResetPassword" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efResetPassword">
        <description>Validate password-reset OTP and update the password.</description>
        <attribute name="token" type="String" mode="IN" optional="false"/>
        <attribute name="newPassword" type="String" mode="IN" optional="false"/>
    </service>

    <service name="efGetProfile" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efGetProfile">
        <description>Return the authenticated member's profile.</description>
        <attribute name="member" type="java.util.Map" mode="OUT" optional="true"/>
    </service>

    <service name="efAcceptConsent" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efAcceptConsent">
        <description>Record the member's consent to a consent document.</description>
        <attribute name="documentId" type="String" mode="IN" optional="false"/>
        <attribute name="ipAddress" type="String" mode="IN" optional="true"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
    </service>

    <service name="efListConsents" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.account.EfMemberServices"
             invoke="efListConsents">
        <description>List consents recorded for the authenticated member.</description>
        <attribute name="consents" type="java.util.List" mode="OUT" optional="true"/>
    </service>

    <!-- ========================================================= -->
    <!-- W1: Product catalog (no auth)                            -->
    <!-- ========================================================= -->
    <service name="efListProducts" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.catalog.EfCatalogServices" invoke="efListProducts">
        <description>List published financial products. Authentication not required.</description>
        <attribute name="targetEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="products" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efGetProduct" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.catalog.EfCatalogServices" invoke="efGetProduct">
        <description>Get a single published financial product by productId.</description>
        <attribute name="productId" type="String" mode="IN" optional="false"/>
        <attribute name="product" type="Map" mode="OUT" optional="true"/>
    </service>

    <service name="efSimulateLoan" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.catalog.EfCatalogServices" invoke="efSimulateLoan">
        <description>Simulate loan repayment schedule. No authentication required. Result is not saved.</description>
        <attribute name="productId" type="String" mode="IN" optional="false"/>
        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="termMonths" type="Integer" mode="IN" optional="false"/>
        <attribute name="repaymentMethod" type="String" mode="IN" optional="true"/>
        <attribute name="annualInterestRate" type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="monthlyPayment" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="totalPayment" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="totalInterest" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="effectiveAnnualRate" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="schedule" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efSimulateLease" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.catalog.EfCatalogServices" invoke="efSimulateLease">
        <description>Simulate lease payment schedule. No authentication required. Result is not saved.</description>
        <attribute name="productId" type="String" mode="IN" optional="false"/>
        <attribute name="acquisitionCost" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="termMonths" type="Integer" mode="IN" optional="false"/>
        <attribute name="taxRate" type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="monthlyLeaseAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="totalLeaseAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="totalTax" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="calcInterestRate" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="schedule" type="List" mode="OUT" optional="true"/>
    </service>
    <!-- W2: Application form schema (auth=false) -->
    <service name="efGetApplicationForm" engine="java" auth="false" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efGetApplicationForm">
        <description>Return the field schema for the given product and application type.</description>
        <attribute name="productId" type="String" mode="IN" optional="false"/>
        <attribute name="applicationTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="steps" type="List" mode="OUT" optional="true"/>
        <attribute name="totalSteps" type="Integer" mode="OUT" optional="true"/>
    </service>

    <!-- W2: Draft CRUD -->
    <service name="efCreateDraft" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efCreateDraft">
        <description>Create a new application draft.</description>
        <attribute name="productId" type="String" mode="IN" optional="false"/>
        <attribute name="applicationTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="sourceEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="draftId" type="String" mode="OUT" optional="true"/>
        <attribute name="expiresAt" type="Timestamp" mode="OUT" optional="true"/>
    </service>

    <service name="efSaveDraft" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efSaveDraft">
        <description>Save/update draft step data. Returns validation result for the step.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="step" type="Integer" mode="IN" optional="false"/>
        <attribute name="stepData" type="Map" mode="IN" optional="false"/>
        <attribute name="stepValid" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="validationErrors" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efGetDraft" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efGetDraft">
        <description>Get draft data including all steps and attached documents.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="draft" type="Map" mode="OUT" optional="true"/>
    </service>

    <service name="efListDrafts" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efListDrafts">
        <description>List the member's active drafts.</description>
        <attribute name="drafts" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efWithdrawDraft" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efWithdrawDraft">
        <description>Withdraw (cancel) a draft.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
    </service>

    <!-- W2: Document upload/delete -->
    <service name="efUploadDraftDocument" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efUploadDraftDocument">
        <description>Upload a document to a draft.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="documentTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="IN" optional="false"/>
        <attribute name="contentType" type="String" mode="IN" optional="false"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="draftDocumentId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efDeleteDraftDocument" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efDeleteDraftDocument">
        <description>Delete a document from a draft.</description>
        <attribute name="draftDocumentId" type="String" mode="IN" optional="false"/>
    </service>

    <!-- W2: Submit application -->
    <service name="efSubmitApplication" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfApplicationServices" invoke="efSubmitApplication">
        <description>Submit a completed draft as a finance application.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="ipAddress" type="String" mode="IN" optional="true"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
        <attribute name="financeApplicationId" type="String" mode="OUT" optional="true"/>
        <attribute name="financeApplicationTypeId" type="String" mode="OUT" optional="true"/>
        <attribute name="fraudResult" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ========================================================= -->
    <!-- W3: KYC identity verification                            -->
    <!-- ========================================================= -->
    <service name="efStartKyc" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="efStartKyc">
        <description>Start a KYC identity check for the logged-in member.</description>
        <attribute name="draftId" type="String" mode="IN" optional="true"/>
        <attribute name="kycMethodEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="kycCheckId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efUploadKycImage" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="efUploadKycImage">
        <description>Upload a KYC image (ID doc, facial, IC data).</description>
        <attribute name="kycCheckId" type="String" mode="IN" optional="false"/>
        <attribute name="imageTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="IN" optional="false"/>
        <attribute name="contentType" type="String" mode="IN" optional="false"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="kycImageId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efSubmitKyc" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="efSubmitKyc">
        <description>Submit the KYC check for review.</description>
        <attribute name="kycCheckId" type="String" mode="IN" optional="false"/>
    </service>

    <service name="efGetKycStatus" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="efGetKycStatus">
        <description>Get the current status of a KYC check.</description>
        <attribute name="kycCheckId" type="String" mode="IN" optional="true"/>
        <attribute name="draftId" type="String" mode="IN" optional="true"/>
        <attribute name="kycCheck" type="Map" mode="OUT" optional="true"/>
        <attribute name="images" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="reviewEfKycCheck" engine="java" auth="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="reviewEfKycCheck">
        <description>Staff review of a submitted KYC check (VERIFIED/RESUBMIT/REJECTED).</description>
        <permission-service service-name="efinanceAdminPermission"/>
        <attribute name="kycCheckId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
        <attribute name="confirmerNote" type="String" mode="IN" optional="true"/>
    </service>

    <service name="efIsKycVerified" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.kyc.EfKycServices" invoke="efIsKycVerified">
        <description>Check whether the member (or subject party) has a VERIFIED KYC check.</description>
        <attribute name="subjectPartyId" type="String" mode="IN" optional="true"/>
        <attribute name="draftId" type="String" mode="IN" optional="true"/>
        <attribute name="verified" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="kycCheckId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ========================================================= -->
    <!-- W4: Pre-screen and application status                    -->
    <!-- ========================================================= -->
    <service name="efPreScreen" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfPreScreenServices" invoke="efPreScreen">
        <description>Run pre-screen checks against draft step data. Returns result hint only (not score/rules).</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="result" type="String" mode="OUT" optional="true"/>
        <attribute name="guidance" type="String" mode="OUT" optional="true"/>
        <attribute name="disclaimer" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efGetApplicationStatus" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfPreScreenServices" invoke="efGetApplicationStatus">
        <description>Get the customer-facing stage of an application based on finance statuses.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="stageEnumId" type="String" mode="OUT" optional="true"/>
        <attribute name="stageDescription" type="String" mode="OUT" optional="true"/>
        <attribute name="nextAction" type="String" mode="OUT" optional="true"/>
        <attribute name="applicationStatus" type="Map" mode="OUT" optional="true"/>
    </service>

    <service name="efCreateDocumentRequest" engine="java" auth="true"
             location="org.apache.ofbiz.efinance.application.EfPreScreenServices" invoke="efCreateDocumentRequest">
        <description>Staff creates an additional document request for a draft/application.</description>
        <permission-service service-name="efinanceAdminPermission"/>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="documentTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <attribute name="dueDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="docRequestId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efListDocumentRequests" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfPreScreenServices" invoke="efListDocumentRequests">
        <description>List document requests for an application draft.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="docRequests" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efSubmitRequestedDocument" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.application.EfPreScreenServices" invoke="efSubmitRequestedDocument">
        <description>Customer submits a document for a pending document request.</description>
        <attribute name="docRequestId" type="String" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="IN" optional="false"/>
        <attribute name="contentType" type="String" mode="IN" optional="false"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
    </service>

    <!-- ========================================================= -->
    <!-- W5: Contract flow                                        -->
    <!-- ========================================================= -->
    <service name="efGetOffer" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efGetOffer">
        <description>Get the current presented quote (offer) for an application draft.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="offer" type="Map" mode="OUT" optional="true"/>
        <attribute name="quoteId" type="String" mode="OUT" optional="true"/>
        <attribute name="quoteTypeId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efAcceptOffer" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efAcceptOffer">
        <description>Customer accepts the presented offer (requires re-authentication handled at API layer).</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="quoteId" type="String" mode="IN" optional="false"/>
        <attribute name="quoteTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="acceptedQuoteId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efStartSigning" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efStartSigning">
        <description>Start the signing session for an accepted offer.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="quoteId" type="String" mode="IN" optional="false"/>
        <attribute name="quoteTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="signingSessionId" type="String" mode="OUT" optional="true"/>
        <attribute name="contractSummary" type="Map" mode="OUT" optional="true"/>
    </service>

    <service name="efCompleteSigning" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efCompleteSigning">
        <description>Complete signing (click-wrap consent) and create the finance agreement.</description>
        <attribute name="signingSessionId" type="String" mode="IN" optional="false"/>
        <attribute name="confirmContent" type="Boolean" mode="IN" optional="false"/>
        <attribute name="ipAddress" type="String" mode="IN" optional="true"/>
        <attribute name="deviceId" type="String" mode="IN" optional="true"/>
        <attribute name="agreementId" type="String" mode="OUT" optional="true"/>
        <attribute name="agreementTypeId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="efListDocuments" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efListDocuments">
        <description>List delivered documents for an application draft.</description>
        <attribute name="draftId" type="String" mode="IN" optional="false"/>
        <attribute name="documents" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="efDownloadDocument" engine="java" auth="true" export="true"
             location="org.apache.ofbiz.efinance.contract.EfContractServices" invoke="efDownloadDocument">
        <description>Get document metadata and text content (binary streaming via efinance content layer).</description>
        <attribute name="deliveredDocId" type="String" mode="IN" optional="false"/>
        <attribute name="document" type="Map" mode="OUT" optional="true"/>
        <attribute name="mimeTypeId" type="String" mode="OUT" optional="true"/>
        <attribute name="fileName" type="String" mode="OUT" optional="true"/>
        <attribute name="textData" type="String" mode="OUT" optional="true"/>
    </service>

</services>
